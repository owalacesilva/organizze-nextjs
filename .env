# API Configuration

# Base URL for API requests (leave empty for relative URLs in production)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Simulated API
# With `true` the app answers every request from lib/simulation (in-memory,
# seeded data) instead of calling the backend. Set to `false` to use the real API.
NEXT_PUBLIC_SIMULATE_API=true

# Database URL (for future database integration)
# DATABASE_URL=

# API Rate Limiting
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW=900000

# Transaction Settings
DEFAULT_CURRENCY=USD
MAX_TRANSACTION_AMOUNT=1000000
MIN_TRANSACTION_AMOUNT=0.01

# Pagination Settings
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
